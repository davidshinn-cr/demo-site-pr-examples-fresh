{
  "name": "demo-site-pr-examples",
  "version": "0.1.0",
  "private": true,
  "description": "CodeRabbit quote-to-order demonstration application",
  "type": "module",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.10.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@types/node": "24.10.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --watch src/server.ts",
    "build": "npm run typecheck && vite build",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:check": "npm audit --audit-level=low",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:coverage && npm run security:check"
  }
}
